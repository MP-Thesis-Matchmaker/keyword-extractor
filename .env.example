# Postgres with the harvested corpus (same DB backend-core uses).
# Loaded demo instance: cd ../backend-core/demo && docker compose up -d
DATABASE_URL=postgresql://matchmaker:matchmaker@localhost:5432/matchmaker

# KeyBERT embedding model (any sentence-transformers name). "fake" selects the
# deterministic offline extractor (tests/CI, no model download).
# Multilingual by default: ~10% of eligible publications are not English, and
# postings carry no language label at all, so one model has to handle both.
# Deliberately NOT BAAI/bge-m3: extracting keywords in the retrieval model's own
# embedding space would bias the benchmark toward the system under test.
# Set KEYBERT_MODEL=BAAI/bge-m3 only as a deliberate upper-bound check.
KEYBERT_MODEL=paraphrase-multilingual-MiniLM-L12-v2

# Token cap for the document vector KeyBERT ranks keyphrases against. Unset
# keeps the model's shipped 128 (what it was distilled at). 256 is a valid
# sensitivity run -- the checkpoint has 512 position embeddings -- but is not
# the default, since those positions were never tuned.
# KEYBERT_MAX_SEQ_LENGTH=256

# Natural-language query synthesis. Empty = deterministic template (offline).
# Development LLM: LLM_BASE_URL=http://localhost:11434/v1 (Ollama, in
# backend-core's docker-compose).
LLM_BASE_URL=
LLM_MODEL=llama3.1
LLM_API_KEY=

# Attempts per query when the endpoint fails transiently -- 429, 5xx, a read
# timeout. Unrelated to the unsupported-field retry, which corrects the payload
# and costs no attempt. A full run makes thousands of sequential calls, so
# without this a single blip permanently downgrades one row to template text.
# LLM_MAX_ATTEMPTS=3

# Reasoning models only (gpt-5, o-series, Qwen3, DeepSeek-R1): bounds the hidden
# reasoning each query is allowed to cost. Worth setting for a large run, where
# a reasoning model can otherwise think for several seconds per query.
# An endpoint that does not know the field gets a retry without it.
# LLM_REASONING_EFFORT=low

# The matcher's HTTP API (`themis-matcher serve` in backend-core; default :8100).
# `keyword-extractor evaluate` retrieves through it. Nothing from backend-core
# runs in this process any more, so no embedding model is loaded here and no
# sibling checkout is needed -- if the matcher answers, evaluation works.
# backend-core exempts this one variable from its per-member MATCHER_ prefixing,
# so it is spelled the same on both sides and one .env still serves both repos.
MATCHER_BASE_URL=http://127.0.0.1:8100

# Long enough for a cold query: the matcher may still be loading bge-m3 when the
# first one arrives.
# MATCHER_TIMEOUT_S=60

# Attempts per query when the matcher fails transiently -- a saturated pool, a
# read timeout. Never applied to a 409 (no index, indexing in flight, model
# mismatch): those are standing conditions a retry cannot clear.
# MATCHER_MAX_ATTEMPTS=3

# Concurrent /v1/match calls. Leave at 1. The connection pool caps at 5, but the
# matcher embeds every query with a shared, non-thread-safe tokenizer, so two
# concurrent queries race and one comes back 500 (Already borrowed).
# MATCHER_CONCURRENCY=1
